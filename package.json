{
  "name": "dao-den-long",
  "version": "1.0.0",
  "description": "Đảo Đèn Lồng — 3D third-person lantern-keeper game (Day 12 AI SDLC lab)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "headless": "node src/headless.js",
    "bench": "node scripts/bench.mjs --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc --jitless --max-semi-space-size=1 src/soak.js --seed 7 --nights 10 --out soak.json",
    "export-leaderboard": "node server.js --export-leaderboard leaderboard-export.json"
  },
  "dependencies": {
    "three": "0.160.0"
  }
}
